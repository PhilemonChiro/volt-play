{
  "name": "volt-play",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "dev": "vite",
    "build": "sh scripts/build-wasm.sh && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "esbuild tests/courses.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/courses.test.mjs --log-level=error && node node_modules/.cache/courses.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.156.0"
  }
}
