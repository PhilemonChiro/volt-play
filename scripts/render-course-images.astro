---
// Renders the Learn Volt course images (public/learn/*.webp) and where their
// labels point (src/learn-labels.json) from the landing page's DevKitC model.
// To use: copy into web/src/pages/, run `npx astro dev` there and a small server
// on 127.0.0.1:4399 that saves POSTed files, open /render-tiles, then remove it.
<html><body style="margin:0;background:#222">
<p id="log" style="color:#fff;font:14px monospace"></p>
<script>
import * as THREE from 'three';
import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
import { MeshoptDecoder } from 'three/examples/jsm/libs/meshopt_decoder.module.js';
import { GEOM, pinMM } from '../lib/devkitc';

const W = 1200, H = 600;
const log = (t: string) => (document.querySelector('#log')!.textContent += t + '  ');
const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
renderer.setPixelRatio(1);
renderer.setSize(W, H);
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.0;
renderer.outputColorSpace = THREE.SRGBColorSpace;
document.body.append(renderer.domElement);

const scene = new THREE.Scene();
scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;
scene.environmentIntensity = 0.6;
const key = new THREE.DirectionalLight(0xffffff, 1.8);
key.position.set(-0.05, 0.12, 0.08);
scene.add(key);
const rim = new THREE.DirectionalLight(0xffffff, 0.6);
rim.position.set(0.08, 0.05, -0.1);
scene.add(rim);

const gltf = await new GLTFLoader().setMeshoptDecoder(MeshoptDecoder).loadAsync('/models/devkitc.glb');
gltf.scene.traverse((o) => {
  const m = (o as THREE.Mesh).material as THREE.MeshPhysicalMaterial | undefined;
  if (!m?.name) return;
  if (m.name === 'soldermask') Object.assign(m, { clearcoat: 0.3, clearcoatRoughness: 0.35, roughness: 0.5 }), m.color.set(0x0a1828);
  if (m.name === 'shield') Object.assign(m, { roughness: 0.28 }), m.color.set(0xc4cad0);
  if (m.name === 'silkscreen') m.color.set(0xe2e7ea);
});
const board = new THREE.Group();
board.add(gltf.scene);
board.rotation.y = THREE.MathUtils.degToRad(-7);
scene.add(board);

// Soft contact shadow.
const sh = document.createElement('canvas');
sh.width = sh.height = 256;
const g = sh.getContext('2d')!;
const grad = g.createRadialGradient(128, 128, 8, 128, 128, 128);
grad.addColorStop(0, 'rgba(5,12,20,0.45)');
grad.addColorStop(1, 'rgba(5,12,20,0)');
g.fillStyle = grad;
g.fillRect(0, 0, 256, 256);
const shadow = new THREE.Mesh(new THREE.PlaneGeometry(0.085, 0.05), new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(sh), transparent: true, depthWrite: false }));
shadow.rotation.x = -Math.PI / 2;
shadow.position.y = -0.0095;
board.add(shadow);

const ray = new THREE.Raycaster();
const pinAt = (gpio: number) => {
  const mm = pinMM(gpio)!;
  const x = (mm.x - GEOM.L / 2) / 1000, z = (mm.y - GEOM.W / 2) / 1000;
  ray.set(new THREE.Vector3(x, 0.05, z), new THREE.Vector3(0, -1, 0));
  const hit = ray.intersectObject(gltf.scene, true)[0];
  return new THREE.Vector3(x, hit ? hit.point.y : 0.0016, z);
};

// A lit pin: a glowing ring and a soft halo, in the course's colour.
const props: THREE.Object3D[] = [];
function glow(color: number, size = 1) {
  const c = document.createElement('canvas');
  c.width = c.height = 128;
  const x = c.getContext('2d')!;
  const gr = x.createRadialGradient(64, 64, 0, 64, 64, 64);
  const col = new THREE.Color(color);
  const rgb = `${Math.round(col.r * 255)},${Math.round(col.g * 255)},${Math.round(col.b * 255)}`;
  gr.addColorStop(0, `rgba(${rgb},0.95)`);
  gr.addColorStop(0.35, `rgba(${rgb},0.45)`);
  gr.addColorStop(1, `rgba(${rgb},0)`);
  x.fillStyle = gr;
  x.fillRect(0, 0, 128, 128);
  const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(c), depthWrite: false, blending: THREE.AdditiveBlending, transparent: true }));
  s.scale.setScalar(0.006 * size);
  return s;
}
function light(gpio: number, color: number) {
  const p = pinAt(gpio);
  const ring = new THREE.Mesh(new THREE.TorusGeometry(0.00125, 0.00026, 16, 48), new THREE.MeshBasicMaterial({ color }));
  ring.rotation.x = -Math.PI / 2;
  ring.position.copy(p).setY(p.y + 0.0004);
  const halo = glow(color);
  halo.position.copy(p).setY(p.y + 0.0012);
  board.add(ring, halo);
  props.push(ring, halo);
}
function glowAt(x: number, y: number, z: number, color: number, size: number) {
  const s = glow(color, size);
  s.position.set(x, y, z);
  board.add(s);
  props.push(s);
}

const camera = new THREE.PerspectiveCamera(24, W / H, 0.001, 1);
function view(dist: number, elev: number, az: number, look: [number, number, number] = [0, 0, 0]) {
  const t = new THREE.Vector3(...look);
  const e = THREE.MathUtils.degToRad(elev), a = THREE.MathUtils.degToRad(az);
  camera.position.set(t.x + dist * Math.cos(e) * Math.sin(a), t.y + dist * Math.sin(e), t.z + dist * Math.cos(e) * Math.cos(a));
  camera.lookAt(t);
}

const BLUE = 0x4da3ff, GREEN = 0x3ddc84, RED = 0xff5a5a, AMBER = 0xffb84d, VIOLET = 0xb48cff, TEAL = 0x3fd8c0, PINK = 0xff7ab8, CYAN = 0x4dd6ff;
// x: +toward antenna (module end), z: +toward J3 header.
type Label = { at: number | [number, number, number]; text: string; tone?: 'error' | 'warn' };
const shots: Record<string, () => Label[]> = {
  tour: () => {
    [2, 23, 27].forEach((p) => light(p, BLUE));
    view(0.118, 34, 28);
    return [{ at: 2, text: 'lamp' }, { at: 23, text: 'heartbeat' }, { at: 27, text: 'button' }];
  },
  pins: () => {
    light(18, GREEN); light(6, RED); light(0, AMBER); light(4, GREEN);
    view(0.088, 24, 14, [0.001, 0, 0.006]);
    return [{ at: 6, text: 'GPIO 6: wired to flash', tone: 'error' }];
  },
  time: () => {
    light(2, VIOLET); light(23, VIOLET);
    view(0.112, 82, 2);
    return [{ at: 2, text: 'every 1s' }, { at: 23, text: 'every 120ms' }];
  },
  machines: () => {
    light(4, TEAL); light(27, TEAL);
    view(0.1, 30, -60, [-0.002, 0, 0]);
    return [{ at: 4, text: 'locked -> unlocked' }, { at: 27, text: 'on button.is_pressed()' }];
  },
  tasks: () => {
    [2, 4, 18, 19, 21, 22, 23].forEach((p) => light(p, PINK));
    view(0.108, 40, -12, [0, 0, 0.003]);
    return [{ at: 2, text: 'task buttons' }, { at: 22, text: 'task report' }];
  },
  devices: () => {
    light(21, GREEN); light(22, GREEN);
    view(0.08, 34, 38, [0.006, 0, 0.007]);
    return [{ at: 21, text: 'BME280 on I2C, 0x76' }];
  },
  storage: () => {
    glowAt(0.013, 0.004, 0, AMBER, 4.2);
    view(0.086, 44, 115, [0.01, 0, 0]);
    return [{ at: [0.013, 0.004, 0], text: 'storage presses: int = 0' }];
  },
  channels: () => {
    light(25, CYAN); light(5, CYAN);
    view(0.11, 52, 150);
    return [{ at: 25, text: 'events.send(1)' }, { at: 5, text: 'events.receive()' }];
  },
  failures: () => {
    glowAt(0.028, 0.002, 0, RED, 3.4);
    view(0.085, 28, 70, [0.013, 0, 0]);
    return [{ at: [0.028, 0.002, 0], text: 'or retry(5)' }];
  },
};

// Where each label's point lands in the image, as fractions of its width and height.
const placed: Record<string, { x: number; y: number; text: string; tone?: string }[]> = {};
for (const [name, setup] of Object.entries(shots)) {
  props.splice(0).forEach((o) => board.remove(o));
  const labels = setup();
  board.updateMatrixWorld(true);
  camera.updateMatrixWorld(true);
  placed[name] = labels.map((l) => {
    const local = typeof l.at === 'number' ? pinAt(l.at).setY(pinAt(l.at).y + 0.0008) : new THREE.Vector3(...l.at);
    const v = board.localToWorld(local.clone()).project(camera);
    return { x: +((v.x + 1) / 2).toFixed(4), y: +((1 - v.y) / 2).toFixed(4), text: l.text, tone: l.tone };
  });
  renderer.render(scene, camera);
  const blob: Blob = await new Promise((r) => renderer.domElement.toBlob((b) => r(b!), 'image/webp', 0.9));
  const res = await fetch(`http://127.0.0.1:4399/?name=${name}.webp`, { method: 'POST', body: blob });
  log(await res.text());
}
const res = await fetch('http://127.0.0.1:4399/?name=labels.json', { method: 'POST', body: JSON.stringify(placed, null, 1) });
log(await res.text());
log('DONE');
</script>
</body></html>
